# Puerto del servidor (Render/Railway lo inyectan automáticamente)
PORT=3000

# Datos de conexión a MySQL (los entrega tu proveedor: Aiven, Railway, etc.)
DB_HOST=tu-host.mysql.ejemplo.com
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=ecommerce

# true = conexión cifrada SSL/TLS (obligatorio en la mayoría de bases en la nube).
# En MySQL local déjalo en false.
DB_SSL=true

# Opcional: ruta al certificado CA del proveedor (Aiven lo exige: descárgalo como ca.pem)
# DB_SSL_CA=./ca.pem
